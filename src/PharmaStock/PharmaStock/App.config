<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Adapter Uid / Pwd / Server selon votre installation MySQL locale -->
    <add name="PharmaStock"
         connectionString="Server=localhost;Port=3306;Database=pharmastock;Uid=root;Pwd=;SslMode=None;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
